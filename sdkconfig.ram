CONFIG_IDF_TARGET="esp32c3"
# Run entirely from RAM: loaded with `esptool.py load_ram`, flash is never written.
CONFIG_APP_BUILD_TYPE_RAM=y
CONFIG_APP_BUILD_TYPE_PURE_RAM_APP=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Benchmarks keep the CPU busy for long stretches on purpose.
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_INT_WDT=n
# Keep the image small: RAM is shared between code, stacks and heap.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_NEWLIB_NANO_FORMAT=y
